# AI RAG Chatbot Template - OPEN SOURCE FIRST
# All vector stores and LLMs have FREE open source alternatives

# ==========================================
# ENVIRONMENT
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# VECTOR STORE - CHROMA (OPEN SOURCE)
# ==========================================
# Chroma is a free, open source vector database
# Install: pip install chromadb
# Or use Docker: docker run -p 8000:8000 chromadb/chroma
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_chatbot

# ==========================================
# ALTERNATIVE: FAISS (LOCAL, NO SERVER)
# ==========================================
# FAISS runs entirely locally, no server needed
# VECTOR_STORE_TYPE=faiss
# FAISS_INDEX_PATH=./data/faiss_index

# ==========================================
# ALTERNATIVE: WEAVIATE (OPEN SOURCE)
# ==========================================
# Self-host Weaviate or use free tier
# VECTOR_STORE_TYPE=weaviate
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=your_weaviate_key_here

# ==========================================
# ALTERNATIVE: PINECONE (Cloud)
# ==========================================
# Only if you prefer cloud hosting
# VECTOR_STORE_TYPE=pinecone
# PINECONE_API_KEY=your_pinecone_key_here
# PINECONE_INDEX=rag-chatbot
# PINECONE_ENVIRONMENT=us-west1-gcp

# ==========================================
# EMBEDDINGS - SENTENCE TRANSFORMERS (FREE)
# ==========================================
# HuggingFace sentence-transformers, completely free
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ==========================================
# LLM - OLLAMA (LOCAL, FREE)
# ==========================================
# Install: https://ollama.com
# Required: ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1000

# ==========================================
# ALTERNATIVE: LM STUDIO (LOCAL, FREE)
# ==========================================
# Download: https://lmstudio.ai
# Load any GGUF model
# LLM_PROVIDER=lmstudio
# LMSTUDIO_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model

# ==========================================
# ALTERNATIVE: GROQ (FREE TIER)
# ==========================================
# Sign up: https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.2-70b-versatile

# ==========================================
# ALTERNATIVE: OPENAI (Paid)
# ==========================================
# Only if you want premium quality
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# ==========================================
# RETRIEVAL SETTINGS
# ==========================================
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==========================================
# API SERVER
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ==========================================
# DATA PERSISTENCE
# ==========================================
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
UPLOAD_MAX_SIZE=10485760

# ==========================================
# 100% FREE OPEN SOURCE SETUP
# ==========================================
# 1. Vector Store:
#    pip install chromadb
#    # Or use Docker: docker run -p 8000:8000 chromadb/chroma
#
# 2. Embeddings:
#    pip install sentence-transformers
#    # Automatically downloads model on first run
#
# 3. LLM:
#    # Install Ollama from https://ollama.com
#    ollama pull llama3.2
#
# 4. Start the API:
#    cd starter
#    pip install -r requirements.txt
#    python main.py
#
# This gives you a complete RAG chatbot with ZERO API costs!
# All components run locally and are fully open source.
#
# Optional: Add API keys above for cloud providers as backup
